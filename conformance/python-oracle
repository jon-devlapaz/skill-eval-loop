#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
command_name="${1:-}"
if [[ -z "$command_name" ]]; then
  printf 'ERROR: command is required\n' >&2
  exit 2
fi
shift

case "$command_name" in
  audit)
    exec python3 "$repo_root/skills/skill-eval-loop/scripts/audit_suite.py" "$@"
    ;;
  recommend-models)
    exec python3 "$repo_root/skills/skill-eval-loop/scripts/recommend_models.py" "$@"
    ;;
  run)
    exec python3 "$repo_root/skills/skill-eval-loop/scripts/run_skill_eval.py" "$@"
    ;;
  aggregate)
    exec python3 "$repo_root/skills/skill-eval-loop/scripts/aggregate_benchmark.py" "$@"
    ;;
  healthcheck)
    exec bash "$repo_root/skills/skill-eval-loop/scripts/healthcheck.sh" "$@"
    ;;
  *)
    printf 'ERROR: unknown command: %s\n' "$command_name" >&2
    exit 2
    ;;
esac
