#!/bin/sh
set -eu
if [ "${1:-}" = "--version" ]; then
  printf '{"executable":"fake-codex","argv":["fake-codex","--version"],"cwd":"%s","order":1,"status":0,"timed_out":false}\n' "$PWD" >> "$SKILL_EVAL_CONFORMANCE_LOG"
  printf 'fake-codex 1.0\n'
  exit 0
fi
if [ "${1:-}" = "exec" ]; then
  with_skill=false
  for argument in "$@"; do
    case "$argument" in
      'Use the $skill skill.'*) with_skill=true ;;
    esac
  done
  thread=thread-codex-control
  response=no
  skills='[]'
  order=2
  if [ "$with_skill" = true ]; then
    thread=thread-codex-treatment
    response=ok
    skills='["skill"]'
    order=3
  fi
  printf '{"executable":"fake-codex","argv":["fake-codex"' >> "$SKILL_EVAL_CONFORMANCE_LOG"
  for argument in "$@"; do
    escaped=$(printf '%s' "$argument" | sed 's/\\/\\\\/g; s/"/\\"/g')
    printf ',"%s"' "$escaped" >> "$SKILL_EVAL_CONFORMANCE_LOG"
  done
  escaped_home=$(printf '%s' "$HOME" | sed 's/\\/\\\\/g; s/"/\\"/g')
  escaped_codex=$(printf '%s' "$CODEX_HOME" | sed 's/\\/\\\\/g; s/"/\\"/g')
  printf '],"cwd":"%s","environment":{"HOME":"%s","CODEX_HOME":"%s"},"order":%s,"status":0,"timed_out":false}\n' "$PWD" "$escaped_home" "$escaped_codex" "$order" >> "$SKILL_EVAL_CONFORMANCE_LOG"
  mkdir -p "$CODEX_HOME/sessions/fixture"
  rollout="$CODEX_HOME/sessions/fixture/rollout-$thread.jsonl"
  printf '{"type":"turn_context","payload":{"model":"provider/model-terra"}}\n' > "$rollout"
  if [ "$with_skill" = true ]; then
    printf '{"type":"world_state","payload":{"state":{"host_skills":{"body":"- skill: fixture (file: %s/.agents/skills/skill/SKILL.md)"}}}}\n' "$PWD" >> "$rollout"
    printf '{"type":"response_item","payload":{"type":"message","role":"user","content":[{"type":"input_text","text":"<skill>\\n<name>skill</name>\\n<path>%s/.agents/skills/skill/SKILL.md</path>\\n</skill>"}]}}\n' "$PWD" >> "$rollout"
  fi
  printf '{"type":"system","subtype":"init","model":"provider/model-terra","skills":%s}\n' "$skills"
  printf '{"type":"thread.started","thread_id":"%s"}\n' "$thread"
  printf '{"type":"item.completed","item":{"type":"agent_message","text":"%s"}}\n' "$response"
  printf '{"type":"turn.completed","usage":{"input_tokens":1,"output_tokens":1}}\n'
  exit 0
fi
printf 'unexpected invocation\n' >&2
exit 9
