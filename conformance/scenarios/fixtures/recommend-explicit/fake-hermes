#!/bin/sh
set -eu
if [ "${1:-}" = "--version" ]; then
  printf '{"executable":"fake-hermes","argv":["fake-hermes","--version"],"cwd":"%s","order":1,"status":0,"timed_out":false}\n' "$PWD" >> "$SKILL_EVAL_CONFORMANCE_LOG"
  printf 'fake-hermes 1.0\n'
  exit 0
fi
printf 'unexpected invocation\n' >&2
exit 9
